---
import { allPosts, postsByCategory, CATEGORIES, demandPicks, actorPoliticians } from '../lib/content.mjs';
import { MONTHS } from '../lib/bio.mjs';

const { exclude = null } = Astro.props;
const posts = allPosts();
const byCat = postsByCategory();
const recent = posts.filter((p) => p.slug !== exclude).slice(0, 6);
const popular = demandPicks(exclude, 5);
const cats = Object.entries(CATEGORIES).filter(([k]) => byCat[k]?.length)
  .sort((a, b) => byCat[b[0]].length - byCat[a[0]].length);

/* Mirrors the threshold in /born/[decade].astro — link only the decades
   that actually have a page built, or the sidebar 404s as the queue
   publishes into new decades. */
const decades = (() => {
  const counts = {};
  for (const p of posts) {
    const y = p.birthDate?.year;
    if (y) counts[Math.floor(y / 10) * 10] = (counts[Math.floor(y / 10) * 10] || 0) + 1;
  }
  return Object.entries(counts).filter(([, n]) => n >= 15)
    .sort((a, b) => b[0] - a[0]);
})();
const hasHeights = posts.filter((p) => p.heightCm).length >= 10;
/* Mirrors the list page — link it only once it is a real list. */
const politicianCount = actorPoliticians().length;

/* Same mirroring for /born-in/[city]/ — without these links the city
   pages are orphans that only the sitemap knows about. */
const cities = (() => {
  const counts = {};
  for (const p of posts) {
    const c = String((Array.isArray(p.birthPlace) ? p.birthPlace[0] : p.birthPlace) || '').trim();
    if (c) counts[c] = (counts[c] || 0) + 1;
  }
  return Object.entries(counts).filter(([, n]) => n >= 15).sort((a, b) => b[1] - a[1]);
})();
const citySlug = (x) =>
  x.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const fmt = (s) => {
  if (!s) return '';
  const d = new Date(s + 'T00:00:00Z');
  return `${MONTHS[d.getUTCMonth()]} ${d.getUTCDate()}, ${d.getUTCFullYear()}`;
};
---
<aside class="sidebar">
  <section class="widget">
    <h2 class="w-title">Live Search</h2>
    <form class="w-search" action="/search/" method="get" role="search">
      <input type="search" name="q" placeholder="Search" aria-label="Search celebrity profiles" />
      <button type="submit" aria-label="Search"><span class="mag-dark" aria-hidden="true"></span></button>
    </form>
  </section>

  <section class="widget">
    <h2 class="w-title">Posts</h2>
    <ul class="w-posts">
      {recent.map((p) => (
        <li>
          <a class="wp-img" href={`/${p.slug}/`} tabindex="-1" aria-hidden="true">
            {p.image?.url
              ? <img src={p.image.url} alt="" loading="lazy" width="78" height="78" />
              : <span>{p.name[0]}</span>}
          </a>
          <div>
            <a class="wp-title" href={`/${p.slug}/`}>{p.title}</a>
            <time datetime={p.publishedAt}>{fmt(p.publishedAt)}</time>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="widget">
    <h2 class="w-title">Categories</h2>
    <ul class="w-cats">
      {cats.map(([key, c]) => (
        <li><a href={`/category/${key}/`}>{c.label}<span>{byCat[key].length}</span></a></li>
      ))}
    </ul>
  </section>

  <section class="widget">
    <h2 class="w-title">Most Searched</h2>
    <ol class="w-rank">
      {popular.map((p) => <li><a href={`/${p.slug}/`}>{p.name}</a></li>)}
    </ol>
  </section>

  {(decades.length > 0 || hasHeights || cities.length > 0 || politicianCount >= 10) && (
    <section class="widget">
      <h2 class="w-title">Browse by List</h2>
      <ul class="w-cats">
        {decades.map(([d, n]) => (
          <li><a href={`/born/${d}s/`}>Born in the {d}s<span>{n}</span></a></li>
        ))}
        {cities.map(([c, n]) => (
          <li><a href={`/born-in/${citySlug(c)}/`}>Born in {c}<span>{n}</span></a></li>
        ))}
        {hasHeights && <li><a href="/lists/tallest-celebrities/">Tallest Celebrities</a></li>}
        {politicianCount >= 10 && (
          <li><a href="/lists/actors-who-became-politicians/">Actors Who Became Politicians<span>{politicianCount}</span></a></li>
        )}
        <li><a href="/research/who-becomes-famous-in-india/">Who Becomes Famous in India?</a></li>
        <li><a href="/research/do-actors-go-to-film-school/">Do Actors Go to Film School?</a></li>
        <li><a href="/research/who-famous-people-marry/">Who Do Famous People Marry?</a></li>
      </ul>
    </section>
  )}
</aside>
