---
import Base from '../layouts/Base.astro';
import { SITE } from '../../site.config.mjs';
import { allPosts } from '../lib/content.mjs';
const count = allPosts().length;
---
<Base
  title="Search Celebrity Profiles"
  description={`Search ${count} fact-checked celebrity biographies on ${SITE.name} by name.`}
  noindex={true}
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Search' }]}
>
  <div class="wrap prose">
    <h1>Search profiles</h1>
    <form id="sform" role="search" onsubmit="return false">
      <input id="q" type="search" placeholder="Type a name…" autocomplete="off" autofocus
        aria-label="Search celebrity names"
        style="width:100%;max-width:520px;padding:12px 16px;font:inherit;border:1px solid var(--line);border-radius:10px;background:var(--bg-soft);color:var(--fg)" />
    </form>
    <p class="muted small" id="stat">Searching {count} profiles.</p>
    <div class="grid" id="res"></div>
  </div>

  <script is:inline>
    (async () => {
      const res = document.getElementById('res');
      const stat = document.getElementById('stat');
      const q = document.getElementById('q');
      const data = await fetch('/search-index.json').then((r) => r.json());
      const norm = (s) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
      const index = data.map((d) => ({ ...d, k: norm(d.n) }));

      function render(list, term) {
        res.innerHTML = list.slice(0, 60).map((d) => `
          <a class="tile" href="/${d.s}/">
            <div class="thumb">${d.i
              ? `<img src="${d.i}" alt="${d.n}" loading="lazy" width="240" height="320">`
              : `<div style="width:100%;height:100%;display:grid;place-items:center;font-size:2rem;font-weight:800;color:var(--fg-soft)">${d.n[0]}</div>`}</div>
            <div class="meta"><b>${d.n}</b><span>${d.r}</span></div>
          </a>`).join('');
        stat.textContent = term
          ? `${list.length} match${list.length === 1 ? '' : 'es'} for “${term}”`
          : `Searching ${index.length} profiles.`;
      }

      function run() {
        const term = q.value.trim();
        if (!term) { res.innerHTML = ''; render([], ''); return; }
        const t = norm(term);
        const hits = index
          .filter((d) => d.k.includes(t))
          .sort((a, b) => (a.k.startsWith(t) ? -1 : 1) - (b.k.startsWith(t) ? -1 : 1) || a.n.length - b.n.length);
        render(hits, term);
      }

      q.addEventListener('input', run);
      const pre = new URLSearchParams(location.search).get('q');
      if (pre) { q.value = pre; run(); }
    })();
  </script>
</Base>
