---
import Base from '../../layouts/Base.astro';
import Sidebar from '../../components/Sidebar.astro';
import { SITE } from '../../../site.config.mjs';
import { filmSchoolStats } from '../../lib/study.mjs';

const s = filmSchoolStats();
const n = (x) => (x ?? 0).toLocaleString('en-US');
const pct1 = (x) => x.toFixed(1);

const BAR = { w: 680, rowH: 36, labelW: 220, valueW: 60 };
const plotW = BAR.w - BAR.labelW - BAR.valueW;
const schoolMax = s.schools[0]?.n || 1;
const elseMax = s.elsewhere[0]?.n || 1;

const canonical = `${SITE.domain}/research/do-actors-go-to-film-school/`;
const title = 'Do Actors Go to Film School? 967 Careers Checked';
const description =
  `${pct1(s.untrainedPct)}% of actors with an education on record never attended a film or drama `
  + `school. Those who did hold more credits — ${s.trainedMedianCredits} against `
  + `${s.untrainedMedianCredits} — but are no better known.`;

const csvUrl = `${SITE.domain}/research/do-actors-go-to-film-school.csv`;

const jsonld = [
  {
    '@type': 'Article',
    '@id': `${canonical}#article`,
    url: canonical,
    headline: title,
    description,
    datePublished: '2026-10-05',
    dateModified: '2026-10-05',
    isPartOf: { '@id': `${SITE.domain}/#website` },
    author: { '@id': `${SITE.domain}/#org` },
    publisher: { '@id': `${SITE.domain}/#org` },
    license: 'https://creativecommons.org/licenses/by/4.0/',
    about: { '@id': `${canonical}#dataset` },
  },
  {
    '@type': 'Dataset',
    '@id': `${canonical}#dataset`,
    name: `Film school attendance and screen credits across ${n(s.actorsWithEducation)} actors`,
    description:
      `Counts of film and drama school attendance among actors with an education on record, with `
      + `median screen credits and median monthly search volume for each group. Derived from `
      + `Wikidata. Measures what is recorded, not what is true of the profession.`,
    url: canonical,
    license: 'https://creativecommons.org/licenses/by/4.0/',
    creator: { '@id': `${SITE.domain}/#org` },
    isAccessibleForFree: true,
    spatialCoverage: 'India',
    measurementTechnique: 'Aggregation of structured Wikidata records',
    variableMeasured: ['education', 'screen credits', 'search volume'],
    isBasedOn: 'https://www.wikidata.org/',
    distribution: [{
      '@type': 'DataDownload', encodingFormat: 'text/csv',
      contentUrl: csvUrl, name: 'Aggregate tables (CSV)',
    }],
  },
];
---
<Base
  title={title}
  description={description}
  canonical={canonical}
  jsonld={jsonld}
  type="article"
  published="2026-10-05"
  modified="2026-10-05"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Do Actors Go to Film School?' }]}
>
  <nav class="breadcrumbs wrap" aria-label="Breadcrumb">
    <ol><li><a href="/">Home</a></li><li aria-current="page">Do Actors Go to Film School?</li></ol>
  </nav>
  <div class="wrap">
    <div class="cards-layout">
      <main class="cards-main study">
        <h1>Do Actors Go to Film School?</h1>
        <p class="standfirst">
          We hold an education record for {n(s.actorsWithEducation)} actors. Almost none of them
          trained for the job. The ones who did work more — and are no better known for it.
        </p>

        <h2 id="share">1. Nine in ten never went</h2>
        <p>
          Of the {n(s.actorsWithEducation)} actors with any education on record,
          {' '}<strong>{n(s.untrained)} — {pct1(s.untrainedPct)}% — have no film, drama or theatre
          school among their institutions</strong>. {n(s.trained)} do, which is
          {' '}{pct1(s.trainedPct)}%.
        </p>

        <figure class="chart">
          <svg viewBox="0 0 680 120" role="img"
               aria-label="Share of actors who attended a film or drama school against those who did not">
            <rect x="0" y="20" rx="4" height="26" width={(s.untrainedPct / 100) * 660} class="bar" />
            <text x={(s.untrainedPct / 100) * 660 - 10} y="38" class="inbar">{pct1(s.untrainedPct)}%</text>
            <text x="0" y="68" class="rowlabel left">No film or drama school · {n(s.untrained)} actors</text>
            <rect x="0" y="82" rx="4" height="26" width={Math.max(6, (s.trainedPct / 100) * 660)} class="bar alt" />
            <text x={Math.max(6, (s.trainedPct / 100) * 660) + 10} y="100" class="value">{pct1(s.trainedPct)}%</text>
            <text x="120" y="100" class="rowlabel left">Film or drama school · {n(s.trained)}</text>
          </svg>
          <figcaption>
            Share of actors by whether a film, drama or theatre school appears among their
            recorded institutions. Base: {n(s.actorsWithEducation)} actors with any education on record.
          </figcaption>
        </figure>

        <h2 id="schools">2. Where the trained ones went</h2>
        <p>
          Two institutions account for most of it. The National School of Drama and the Film and
          Television Institute of India together cover
          {' '}{n((s.schools[0]?.n || 0) + (s.schools[1]?.n || 0))} of the {n(s.trained)}.
        </p>

        <figure class="chart">
          <svg viewBox={`0 0 ${BAR.w} ${s.schools.length * BAR.rowH + 8}`} role="img"
               aria-label="Film and drama schools attended, led by the National School of Drama">
            {s.schools.map((x, i) => (
              <g transform={`translate(0 ${i * BAR.rowH})`}>
                <title>{x.name}: {n(x.n)} actors</title>
                <text x={BAR.labelW - 10} y="22" class="rowlabel">{x.name}</text>
                <rect x={BAR.labelW} y="10" rx="4" height="14"
                      width={Math.max(4, (x.n / schoolMax) * plotW)} class="bar" />
                <text x={BAR.labelW + (x.n / schoolMax) * plotW + 8} y="22" class="value">{x.n}</text>
              </g>
            ))}
          </svg>
          <figcaption>Film, drama and theatre schools among the {n(s.trained)} trained actors.</figcaption>
        </figure>

        <h2 id="instead">3. What the rest studied</h2>
        <p>
          General universities and city colleges, mostly — the same institutions anyone else in
          Delhi, Mumbai or Kolkata would attend.
        </p>

        <figure class="chart">
          <svg viewBox={`0 0 ${BAR.w} ${s.elsewhere.length * BAR.rowH + 8}`} role="img"
               aria-label="The most common non-film institutions among actors">
            {s.elsewhere.map((x, i) => (
              <g transform={`translate(0 ${i * BAR.rowH})`}>
                <title>{x.name}: {n(x.n)} actors</title>
                <text x={BAR.labelW - 10} y="22" class="rowlabel">{x.name}</text>
                <rect x={BAR.labelW} y="10" rx="4" height="14"
                      width={Math.max(4, (x.n / elseMax) * plotW)} class="bar" />
                <text x={BAR.labelW + (x.n / elseMax) * plotW + 8} y="22" class="value">{x.n}</text>
              </g>
            ))}
          </svg>
          <figcaption>Most common institutions among actors, excluding film and drama schools.</figcaption>
        </figure>

        <h2 id="outcome">4. Training predicts work, not fame</h2>
        <p>
          Trained actors hold a median of <strong>{s.trainedMedianCredits} screen credits</strong>
          {' '}against <strong>{s.untrainedMedianCredits}</strong> for the rest — they work more.
        </p>
        <p>
          But on how well known they are, the two groups are indistinguishable: a median of
          {' '}<strong>{n(s.trainedMedianVolume)}</strong> monthly searches for the trained against
          {' '}<strong>{n(s.untrainedMedianVolume)}</strong> for the untrained. That is a gap of
          {' '}{pct1(Math.abs(s.trainedMedianVolume - s.untrainedMedianVolume) / s.untrainedMedianVolume * 100)}%,
          which is nothing. Whatever makes an actor famous, film school is not it.
        </p>

        <table class="facts">
          <thead><tr><th></th><th>Film school</th><th>No film school</th></tr></thead>
          <tbody>
            <tr><td>Actors</td><td>{n(s.trained)}</td><td>{n(s.untrained)}</td></tr>
            <tr><td>Median screen credits</td><td>{s.trainedMedianCredits}</td><td>{s.untrainedMedianCredits}</td></tr>
            <tr><td>Median monthly searches</td><td>{n(s.trainedMedianVolume)}</td><td>{n(s.untrainedMedianVolume)}</td></tr>
          </tbody>
        </table>

        <h2 id="method">Method, and what this does not show</h2>
        <p>
          <strong>This measures what is recorded, not what is true of the profession.</strong>
          Education is on record for a minority of people in the dataset, and the rate varies by
          field — {s.coverage.map((c) => `${c.field} ${Math.round((c.withEd / c.n) * 100)}%`).join(', ')}.
          Everything above is taken against the {n(s.actorsWithEducation)} actors who have an
          education recorded at all, never against the full {n(s.total)}.
        </p>
        <p>
          One caveat cuts against the credits finding and is worth stating: screen credits are
          capped at 60 by our own data collection, and {n(s.untrainedAtCap)} untrained actors sit
          exactly on that ceiling against {n(s.trainedAtCap)} trained ones. The untrained group's
          true median is therefore understated by more than the trained group's, so the real gap
          in output is narrower than {s.trainedMedianCredits} against {s.untrainedMedianCredits}.
          The direction holds; the size should not be quoted precisely.
        </p>
        <p>
          A school counts as training if its name contains film, drama, theatre, cinema or acting.
          That will miss a conservatory recorded under a founder's name, and it will catch a
          university's film department. {n(s.distinctInstitutions)} distinct institutions appear
          across the dataset, which is too many to classify by hand.
        </p>

        <h2 id="cite">Reuse and citation</h2>
        <p>
          The underlying facts come from <a href="https://www.wikidata.org/" rel="noopener">Wikidata</a>,
          published under CC0. This analysis is free to reuse with attribution.
        </p>
        <p>
          <a class="dl" href="/research/do-actors-go-to-film-school.csv"
             download="biostar-film-school.csv">Download every table on this page (CSV)</a>
        </p>
        <blockquote class="cite">
          BioStar (2026). <em>Do Actors Go to Film School? {n(s.actorsWithEducation)} Careers
          Checked.</em><br />{canonical}
        </blockquote>
        <p class="muted small">
          See also: <a href="/research/who-becomes-famous-in-india/">Who Becomes Famous in India?</a>
        </p>
      </main>
      <Sidebar />
    </div>
  </div>
</Base>

<style>
  .study { max-width: 760px; }
  .standfirst { font-size: 1.1rem; line-height: 1.65; color: var(--fg-soft); margin-bottom: 2rem; }
  .study h2 { margin-top: 2.5rem; }
  .chart { margin: 1.5rem 0 2rem; }
  .chart svg { width: 100%; height: auto; overflow: visible; }
  .chart figcaption {
    font-size: 0.85rem; color: var(--fg-dim); line-height: 1.5;
    margin-top: 0.5rem; border-top: 1px solid var(--line); padding-top: 0.5rem;
  }
  .bar { fill: #c8102e; }
  .bar.alt { fill: #1368a0; }
  .rowlabel { font-size: 13px; fill: var(--fg-soft); text-anchor: end; }
  .rowlabel.left { text-anchor: start; }
  .value { font-size: 13px; font-weight: 600; fill: var(--fg); }
  .inbar { font-size: 13px; font-weight: 600; fill: #fff; text-anchor: end; }
  .dl {
    display: inline-block; font-weight: 600;
    border: 1px solid var(--line-strong); border-radius: 8px;
    padding: 0.6rem 1rem; text-decoration: none;
  }
  .dl:hover { background: var(--bg-soft); }
  .cite {
    border-left: 3px solid var(--accent); padding: 0.75rem 1rem; margin: 1rem 0;
    background: var(--bg-soft); font-size: 0.9rem; line-height: 1.6;
  }
  @media (max-width: 560px) {
    .rowlabel, .value, .inbar { font-size: 19px; }
  }
</style>
